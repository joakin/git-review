{
  "name": "git-review",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "format:staged": "lint-staged",
    "secrets:install": "bun scripts/check-secrets.ts --install",
    "secrets:check": "bun scripts/check-secrets.ts",
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "build:web": "bun scripts/build-web.ts",
    "build:agent": "bun scripts/build-agent.ts",
    "assets:icons": "bun scripts/render-icons.ts",
    "start": "bun scripts/serve.ts",
    "start:agent": "bun dist/agent/agent.js",
    "start:cloud": "bun dist/agent/cloud.js",
    "typecheck": "tsc -p apps/agent/tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p apps/web/tsconfig.sw.json && tsc -p packages/shared/tsconfig.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.test.json && tsc -p tsconfig.qa.json",
    "test": "bun test",
    "qa:capture": "bun qa/capture.ts",
    "qa:probe": "bun qa/feasibility.ts",
    "qa:probe:agent": "bun qa/feasibility-agent.ts",
    "qa:probe:fixture": "bun qa/prepare-feasibility-fixture.ts",
    "qa:check": "tsc --noEmit -p tsconfig.qa.json && bun qa/check-package-boundaries.ts && bun qa/check-css-tokens.ts && bun run format:check"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@git-review/shared": "workspace:*",
    "@types/bun": "^1.4.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "playwright-core": "^1.63.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2"
  }
}
