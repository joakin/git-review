{
  "name": "git-review",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "assets:icons": "bun scripts/render-icons.ts",
    "start": "bun src/server/main.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.test.json && tsc -p tsconfig.qa.json",
    "test": "bun test",
    "qa:capture": "bun qa/capture.ts",
    "qa:foundation": "bun qa/check-foundation.ts",
    "qa:tabs": "bun qa/check-tabs.ts",
    "qa:diff": "bun qa/check-diff.ts",
    "qa:files": "bun qa/check-files.ts",
    "qa:media": "bun qa/check-media.ts",
    "qa:media-playback": "bun qa/check-media-playback.ts",
    "qa:search": "bun qa/check-search.ts",
    "qa:selected-search": "bun qa/check-selected-search.ts",
    "qa:voice": "bun qa/check-voice.ts",
    "qa:feedback": "bun qa/check-feedback.ts",
    "qa:feedback-transactions": "bun qa/check-feedback-transactions.ts",
    "qa:modals": "bun qa/check-modals.ts",
    "qa:line-action": "bun qa/check-line-action.ts",
    "qa:live-changes": "bun qa/check-live-changes.ts",
    "qa:typography": "bun qa/check-typography.ts",
    "qa:themes": "bun qa/check-themes.ts",
    "qa:navigation": "bun qa/check-navigation.ts",
    "qa:loading": "bun qa/check-loading.ts",
    "qa:pwa": "bun qa/check-pwa.ts",
    "qa:fixture": "bun qa/prepare-inventory-fixture.ts",
    "qa:git-fixture": "bun qa/prepare-git-fixture.ts",
    "qa:git": "bun qa/check-git.ts",
    "qa:check": "tsc --noEmit -p tsconfig.qa.json && bun qa/check-css-tokens.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "shiki": "^4.4.3"
  }
}
